# ===== PostgreSQL =====
POSTGRES_DB=asset_school
POSTGRES_USER=asset_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ===== Backend (FastAPI) =====
# Строка подключения (для локального запуска вне Docker: host=localhost)
DATABASE_URL=postgresql+asyncpg://asset_user:change_me_strong_password@postgres:5432/asset_school

# Секрет для подписи JWT (обязательно заменить длинным случайным значением:
#   python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change_me_long_random_secret_0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# ===== Backend служебное =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=20

# ===== Безопасность HTTP =====
ENV=development                 # development | production
SECURITY_HEADERS=true           # заголовки безопасности (CSP и др.)
STRICT_CSP=false                # true в production (без inline script/style)
HSTS_ENABLED=false              # true только при HTTPS
ALLOWED_HOSTS=*                 # через запятую или *
LOG_LEVEL=INFO

# ===== Refresh-токен в HttpOnly-куке (дополнительно к телу ответа) =====
COOKIE_NAME=refresh_token
COOKIE_HTTPONLY=true
COOKIE_SECURE=false             # true только при HTTPS
COOKIE_SAMESITE=lax

# ===== Резервное копирование =====
BACKUP_INTERVAL_HOURS=24        # частота pg_dump
BACKUP_RETENTION_DAYS=14        # срок хранения архивов

# ===== Frontend =====
VITE_API_BASE_URL=/api
VITE_APP_TITLE=Учёт имущества школы